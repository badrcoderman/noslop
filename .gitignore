# Local upstream checkouts are pinned by manifests, not committed wholesale.
upstream/*/.git/

# Firmware dumps, payloads, and console captures stay outside Git.
corpus/
*.bin
*.dmp
*.elf
*.sprx
*.self
*.pcap
*.log

